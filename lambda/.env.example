# AWS Configuration
AWS_REGION=ap-southeast-1

# DynamoDB Tables
USER_PROFILES_TABLE=MumCareUserProfiles
NOTIFICATION_TABLE=MumCareNotifications

# Lambda Functions
NOTIFICATION_HANDLER_FUNCTION=MumCareNotificationHandler

# Email Configuration (SES)
FROM_EMAIL=noreply@mumcare.app

# API Endpoint (set after deployment)
NOTIFICATION_API_ENDPOINT=https://xxxxx.execute-api.ap-southeast-1.amazonaws.com/prod/notify
